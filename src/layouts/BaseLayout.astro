---
import "@fontsource-variable/noto-sans-sc";
import "@fontsource-variable/noto-sans-mono";
import "@/styles/globals.css";
import SiteFooter from "@/components/SiteFooter";
import SiteHeader from "@/components/SiteHeader";
import SiteSidebar from "@/components/SiteSidebar";
import { getGroups } from "@/lib/content";
import siteMetadata from "@/lib/site-metadata";

interface Props {
  pageTitle?: string;
  searchable?: boolean;
}

const { pageTitle, searchable = true } = Astro.props;
const title = pageTitle ? `${pageTitle} | ${siteMetadata.title}` : siteMetadata.title;
const groups = await getGroups();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={siteMetadata.description} />
    <link rel="icon" href="/favicon-32x32.png" sizes="any" />
    <meta data-pagefind-meta="title[content]" content={pageTitle ?? siteMetadata.title} />
  </head>
  <body class="antialiased font-sans drawer">
    <div class="flex min-h-screen flex-col drawer-content">
      <!-- Header -->
      <SiteHeader groups={groups} />
      <main class="flex-1" data-pagefind-body={searchable || undefined}><slot /></main>
      <SiteFooter groups={groups} />
    </div>

    <input id="my-drawer" type="checkbox" class="drawer-toggle" />

    <!-- Sidebar -->
    <SiteSidebar groups={groups} />
  </body>
</html>
