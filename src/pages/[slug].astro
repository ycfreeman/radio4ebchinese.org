---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Fancybox from "@/components/Fancybox.astro";
import HeroWithImage, { getHeroImage } from "@/components/HeroWithImage";
import ImageGallery, { getGalleryImages } from "@/components/ImageGallery";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getGroups } from "@/lib/content";

export async function getStaticPaths() {
  return (await getGroups()).map((post) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"groups">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const [heroImage, gallery] = await Promise.all([
  post.data.featuredImage && getHeroImage(post.data.featuredImage),
  post.data.galleryImage && getGalleryImages(post.data.galleryImage),
]);
---

<BaseLayout pageTitle={post.data.title}>
  {
    heroImage && (
      <HeroWithImage image={heroImage} alt={post.data.title} heading={post.data.title} />
    )
  }

  <section class="container mx-auto my-8 p-4 max-w-4xl">
    <h2 class="text-3xl font-bold mb-4">{post.data.title}</h2>
    <div class="prose max-w-none lg:prose-md">
      <Content />
    </div>
    <div class="my-4">
      {
        gallery && (
          <Fancybox>
            <ImageGallery images={gallery} />
          </Fancybox>
        )
      }
    </div>
  </section>
</BaseLayout>
