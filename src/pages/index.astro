---
import { render } from "astro:content";
import HeroWithImage, { getHeroImage } from "@/components/HeroWithImage";
import NewsCard, { getNewsCards } from "@/components/NewsCard";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getNews, getPage } from "@/lib/content";

const [post, news] = await Promise.all([getPage(""), getNews()]);
if (!post) throw new Error("Missing index content");
const { Content } = await render(post);
const [heroImage, cards] = await Promise.all([
  getHeroImage(post.data.featuredImage),
  getNewsCards(news),
]);
---

<BaseLayout>
  <!-- Hero Section -->
  <HeroWithImage
    image={heroImage}
    alt={post.data.title}
    heading={post.data.heading}
    subheading={post.data.subheading}
  />

  <section class="container mx-auto my-8 p-4 max-w-xxl">
    <div class="prose max-w-none lg:prose-md">
      <Content />
    </div>
  </section>
  <!-- Additional sections (News, Footer, etc.) would follow similar conversion -->

  <section class="container mx-auto my-8 p-4 max-w-xxl">
    <h2 class="text-2xl font-bold mb-4">最新動態 | Latest stories</h2>
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-2">
      {cards.map((card) => <NewsCard {...card} />)}
    </div>
  </section>
</BaseLayout>
