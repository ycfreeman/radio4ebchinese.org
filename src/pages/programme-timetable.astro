---
import { render } from "astro:content";
import ArrowRight from "@/components/ArrowRight.astro";
import HeroWithImage from "@/components/HeroWithImage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPage } from "@/lib/content";

const post = await getPage("programme-timetable");
if (!post) throw new Error("Missing programme timetable content");
const { Content } = await render(post);
---

<BaseLayout pageTitle={post.data.title}>
  <HeroWithImage
    alt={post.data.title}
    heading={post.data.heading}
    subheading={post.data.subheading}
    featuredimage={post.data.featuredImage ?? "/placeholder.svg"}
  />
  <section class="container mx-auto my-8 p-4 max-w-4xl">
    <div class="prose max-w-none lg:prose-md">
      <Content components={{ ArrowRight }} />
    </div>
  </section>
</BaseLayout>
