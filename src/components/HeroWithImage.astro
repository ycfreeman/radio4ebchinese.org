---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  featuredimage: ImageMetadata;
  alt: string;
  heading?: string;
  subheading?: string;
}

const post = Astro.props;
---

<section class="hero">
  <div class="hero-overlay">
    <Image
      src={post.featuredimage}
      alt={post.alt}
      widths={[640, 960, 1280, 1600, 2048]}
      sizes="100vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
      class="w-full lg:h-[400px] h-[300px] object-cover"
    />
  </div>

  <div class="hero-content text-neutral-content text-center">
    <div class="w-full flex flex-col items-center justify-center">
      <h1
        class="mb-5 lg:text-5xl text-4xl font-bold text-shadow-lg text-shadow-neutral glass rounded-box px-5 py-2 pb-4"
      >
        {post.heading}
      </h1>
      {
        post.subheading && (
          <h2 class="mb-5 lg:text-2xl text-2xl font-bold text-shadow-sm text-shadow-neutral glass rounded-box px-5 py-2 pb-3">
            {post.subheading}
          </h2>
        )
      }
    </div>
  </div>
</section>
