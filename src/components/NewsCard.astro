---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import ArrowRight from "./ArrowRight.astro";
import { formatDate } from "@/lib/content";

type Props = CollectionEntry<"news">["data"];

const post = Astro.props;
const postUrl = `/news/${post.slug}`;
---

<div class="card lg:card-side bg-neutral-100 shadow-sm">
  <figure class="aspect-square lg:min-w-[55%] sm:min-w-[30%]">
    <Image
      src={post.featuredImage}
      alt="Album"
      widths={[320, 480, 640, 960]}
      sizes="(min-width: 1024px) 28vw, 100vw"
      format="webp"
      class="w-full h-full object-cover"
    />
  </figure>
  <div class="card-body">
    <a href={postUrl}>
      <h2 class="card-title">{post.title}</h2>
    </a>
    <p class="text-sm">{formatDate(post.date)}</p>
    <p class="lg:max-w-2xs">{post.description}</p>
    <div class="card-actions justify-end">
      <a href={postUrl} class="btn btn-primary rounded-field">
        閱讀詳情 | Keep Reading <ArrowRight />
      </a>
    </div>
  </div>
</div>
