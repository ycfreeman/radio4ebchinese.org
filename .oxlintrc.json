{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [".astro/**", "out/**", "build/**"],
  "overrides": [
    {
      "files": ["**/*.{js,mjs,ts,mts,cts}"],
      "rules": {
        "import/no-anonymous-default-export": "warn",
        "no-unused-vars": "warn"
      },
      "plugins": ["import"],
      "env": {
        "browser": true,
        "node": true
      }
    }
  ]
}
